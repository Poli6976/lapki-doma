---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import CookieNotice from '../components/CookieNotice.astro';
import { SITE, MONETIZATION, ANALYTICS } from '../site.config.mjs';
import { absoluteUrl } from '../lib/urls.mjs';

/**
 * @typedef {Object} Props
 * @property {string} title
 * @property {string} [description]
 * @property {string} [image]
 * @property {'website'|'article'} [type]
 * @property {object} [jsonLd] произвольный JSON-LD объект (Article/BreadcrumbList и т.п.)
 * @property {boolean} [noindex]
 */
const {
  title,
  description = SITE.description,
  image,
  type = 'website',
  jsonLd,
  noindex = false,
} = Astro.props;

const pageTitle = title === SITE.name ? title : `${title} · ${SITE.name}`;
const canonical = absoluteUrl(Astro.url.pathname, SITE.url);
const ogImage = image ? absoluteUrl(image, SITE.url) : undefined;
---

<!doctype html>
<html lang={SITE.lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    <meta name="author" content={SITE.author} />
    <meta name="generator" content={Astro.generator} />

    <!-- Open Graph -->
    <meta property="og:type" content={type} />
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content={SITE.locale} />
    {ogImage && <meta property="og:image" content={ogImage} />}

    <!-- Twitter/OG карточка -->
    <meta name="twitter:card" content={ogImage ? 'summary_large_image' : 'summary'} />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />

    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="alternate" type="application/rss+xml" title={SITE.name} href="/rss.xml" />

    <!--
      Сюда позже добавятся мета-теги подтверждения владения сайтом
      (Яндекс.Вебмастер / Admitad / Такпродам и т.п.) — по образцу
      проекта «Расти Дома». Каждый такой тег специфичен для ЭТОГО домена,
      подставлять чужие (с rasti-doma.ru) нельзя — не пройдёт проверку.
    -->

    <!--
      Шрифты стиля Grainy Warm.
      Vollkorn — заголовки. В оригинале стиля стоит Fraunces, но у него
      нет кириллицы: русские заголовки падали бы на системный Georgia.
      Vollkorn — ближайший тёплый сериф с полным кириллическим набором.
    -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@1,600&family=Vollkorn:wght@500;600;700&family=Inter:wght@400;500;600;700;800&display=swap"
    />

    <!--
      Разрешаем прятать элементы под анимацию входа. Стоит в <head>, до
      отрисовки body, иначе hero успел бы мигнуть. Если JS отключён или
      человек просит меньше движения — класс не ставится, и всё видно сразу.
    -->
    <script is:inline>
      if (!window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
        document.documentElement.classList.add('ld-anim');
      }
    </script>

    {
      jsonLd && (
        <script
          type="application/ld+json"
          set:html={JSON.stringify(jsonLd).replace(/</g, '\\u003c')}
        />
      )
    }

    <!-- Яндекс РСЯ (загружается только если задан ID блока) -->
    {
      MONETIZATION.yandexRtbBlockId && (
        <script src="https://yandex.ru/ads/system/context.js" async />
      )
    }

    <!-- Яндекс.Метрика (только если задан номер счётчика).
         Номер прогоняем через Number(): он попадает прямо в тело инлайнового
         скрипта, и так туда физически не может проехать ничего, кроме числа. -->
    {
      Number(ANALYTICS.yaMetrikaId) > 0 && (
        <>
          <script is:inline set:html={`(function(m,e,t,r,i,k,a){m[i]=m[i]||function(){(m[i].a=m[i].a||[]).push(arguments)};m[i].l=1*new Date();for(var j=0;j<document.scripts.length;j++){if(document.scripts[j].src===r){return;}}k=e.createElement(t),a=e.getElementsByTagName(t)[0],k.async=1,k.src=r,a.parentNode.insertBefore(k,a)})(window,document,"script","https://mc.yandex.ru/metrika/tag.js","ym");ym(${Number(ANALYTICS.yaMetrikaId)},"init",{clickmap:true,trackLinks:true,accurateTrackBounce:true});`} />
          <noscript><div><img src={`https://mc.yandex.ru/watch/${Number(ANALYTICS.yaMetrikaId)}`} style="position:absolute; left:-9999px;" alt="" /></div></noscript>
        </>
      )
    }
  </head>
  <body>
    <Header />
    <main>
      <slot />
    </main>
    <Footer />
    <CookieNotice />

    <!--
      Появление секций при прокрутке.
      Прятать элементы стилями нельзя: если скрипт не выполнится, контент
      исчезнет для читателя и для поисковика. Поэтому прячет их сам скрипт —
      нет JS, нет и скрытия. Уважает prefers-reduced-motion.
    -->
    <script is:inline>
      (function () {
        var still = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

        /**
         * Показать элемент жёстко, минуя переход. Переход может зависнуть на
         * первом кадре, если вкладка не отрисовывается, и тогда элемент так и
         * останется прозрачным. Inline-стили с transition: none этого не боятся.
         */
        function forceShow(el) {
          el.classList.remove('reveal');
          el.style.transition = 'none';
          el.style.opacity = '1';
          el.style.transform = 'none';
        }

        // Вход hero: начальное состояние снимаем на следующем кадре, чтобы
        // переход успел зацепиться, и подстраховываемся таймером — к этому
        // моменту анимация (0.27s задержки + 0.6s хода) уже отыграла.
        var entering = document.querySelectorAll('.enter');
        if (entering.length) {
          window.requestAnimationFrame(function () {
            entering.forEach(function (el) {
              el.classList.add('enter-in');
            });
          });
          window.setTimeout(function () {
            entering.forEach(forceShow);
          }, 1500);
        }

        var items = document.querySelectorAll('[data-reveal]');
        if (!items.length) return;
        if (still || !('IntersectionObserver' in window)) return;

        items.forEach(function (el) {
          el.classList.add('reveal');
        });

        function show(el) {
          el.classList.remove('reveal');
          el.classList.add('reveal-in');
        }

        var io = new IntersectionObserver(
          function (entries) {
            entries.forEach(function (entry) {
              if (!entry.isIntersecting) return;
              show(entry.target);
              io.unobserve(entry.target);
            });
          },
          { rootMargin: '0px 0px -12% 0px' },
        );

        items.forEach(function (el) {
          io.observe(el);
        });

        // Страховка. Наблюдатель молчит, пока вкладка не отрисовывается (открыта
        // в фоне, свёрнутое окно), — а до тех пор секции скрыты. Если за две
        // секунды ни одна не показалась, показываем сами: анимация — не та вещь,
        // ради которой можно потерять текст.
        window.setTimeout(function () {
          document.querySelectorAll('[data-reveal].reveal').forEach(function (el) {
            io.unobserve(el);
            forceShow(el);
          });
        }, 2000);
      })();
    </script>
  </body>
</html>
