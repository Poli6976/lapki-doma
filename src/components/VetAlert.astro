---
/**
 * «Красные флаги» — признаки, при которых нельзя ждать и разбираться самому.
 *
 * Смысл блока не в том, чтобы напугать, а в том, чтобы дать человеку чёткую
 * границу: вот здесь можно наблюдать дома, а вот здесь — сразу к врачу.
 * Поэтому оформление заметное, но не паникёрское: цветная полоса слева, а не
 * сплошная красная заливка. Тому, кто уже напуган, красный экран делает хуже.
 *
 * ⚠️ Правило проекта: никаких диагнозов и схем лечения. Здесь только признаки
 *    «нужен осмотр» — что именно происходит с животным, определяет ветеринар.
 *
 * @typedef {Object} Props
 * @property {string[]} [redFlags] признаки, при которых нужен приём
 */
const { redFlags = [] } = Astro.props;
---

{
  redFlags.length > 0 && (
    <section class="vet-alert" aria-labelledby="vet-alert-title">
      <h2 id="vet-alert-title">
        <span class="vet-alert-icon" aria-hidden="true">
          ⚠️
        </span>
        Когда к ветеринару — не откладывая
      </h2>
      <ul>
        {redFlags.map((flag) => (
          <li>{flag}</li>
        ))}
      </ul>
      <p class="vet-alert-tail">
        Если сомневаетесь — позвоните в клинику и опишите, что происходит: по телефону
        подскажут, нужен ли срочный приём. Ждать «до утра» стоит только тогда, когда вам
        это прямо сказали.
      </p>
    </section>
  )
}
