---
/**
 * Блок в самом начале статьи: сначала — присоединение, потом — техника.
 *
 * Человек приходит на такую статью встревоженным («кошка не ест третий день»)
 * и часто винит себя. Если начать с лекции о физиологии, он её не прочитает.
 * Поэтому сверху одна фраза, которая называет его состояние нормальным и
 * объяснимым, а сразу под ней — короткий список того, что можно сделать
 * сегодня. Не пять шагов: два-три посильных.
 *
 * Оба поля необязательны — если в статье не заполнено ничего, блок не
 * выводится вообще и вёрстка не ломается.
 *
 * @typedef {Object} Props
 * @property {string} [reassurance] фраза-валидация: что чувствует читатель и почему это нормально
 * @property {string[]} [tldr] что сделать в ближайшее время, до 4 пунктов
 */
const { reassurance, tldr = [] } = Astro.props;
const hasContent = Boolean(reassurance) || tldr.length > 0;
---

{
  hasContent && (
    <aside class="calm-intro" aria-label="Коротко о главном">
      {reassurance && <p class="reassurance">{reassurance}</p>}
      {tldr.length > 0 && (
        <>
          <span class="tldr-title">Что сделать в первую очередь</span>
          <ol>
            {tldr.map((step) => (
              <li>{step}</li>
            ))}
          </ol>
        </>
      )}
    </aside>
  )
}
