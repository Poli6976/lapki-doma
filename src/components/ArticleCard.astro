---
import { articleUrl } from '../lib/urls.mjs';
import { CATEGORIES, CATEGORY_FALLBACK_ICON } from '../site.config.mjs';

/**
 * @typedef {Object} Props
 * @property {any} entry запись коллекции articles
 */
const { entry } = Astro.props;
const url = articleUrl(entry);
const cat = CATEGORIES.find((c) => c.slug === entry.data.category);
// Нет своей обложки — показываем иконку категории (см. CATEGORIES в site.config.mjs).
const icon = cat?.icon ?? CATEGORY_FALLBACK_ICON;
---

<article class="card">
  <a href={url} class="thumb" aria-hidden="true" tabindex="-1">
    {
      entry.data.cover ? (
        <img src={entry.data.cover} alt={entry.data.coverAlt ?? ''} />
      ) : (
        <span class="thumb-icon"><img src={icon} alt="" width="64" height="64" loading="lazy" /></span>
      )
    }
  </a>
  <div class="body">
    <span class="cat">{cat?.title ?? entry.data.category}</span>
    <h3><a href={url}>{entry.data.title}</a></h3>
    <p>{entry.data.description}</p>
  </div>
</article>
