---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import ArticleCard from '../components/ArticleCard.astro';
import { CATEGORIES } from '../site.config.mjs';
import categoryPhotos from '../data/category-photos.json';

export async function getStaticPaths() {
  return CATEGORIES.map((c) => ({ params: { category: c.slug }, props: { category: c } }));
}

const { category } = Astro.props;
// Лента фото над списком статей: показывает, кого охватывает раздел, даже
// если статьи пока написаны не про всех. Заполняется `fetch-photos.mjs --sets`.
const photos = categoryPhotos[category.slug] ?? [];
// CC BY / CC BY-SA требуют указать автора, public domain и CC0 — нет.
// Подписи собраны под лентой одной строкой, а не под каждым снимком.
const photoCredits = photos.filter(
  (p) => p.author && !/public domain|^cc0/i.test(String(p.license ?? '')),
);
const all = await getCollection('articles', ({ data }) => import.meta.env.PROD ? !data.draft : true);
const articles = all
  .filter((a) => a.data.category === category.slug)
  .sort((a, b) => +new Date(b.data.publishDate) - +new Date(a.data.publishDate));

// Вкладки-подразделы. Показываем только те, что описаны в site.config.mjs,
// и считаем, сколько статей в каждой — пустая вкладка честно говорит «скоро»,
// а не притворяется, что там что-то есть.
const subs = (category.subcategories ?? []).map((s) => ({
  ...s,
  count: articles.filter((a) => a.data.subcategory === s.slug).length,
}));
---

<BaseLayout title={category.title} description={category.description}>
  <section class="hero">
    <div class="container">
      <h1>{category.title}</h1>
      <p class="lead">{category.description}</p>
    </div>
  </section>

  {
    photos.length > 0 && (
      <div class="container container-wide">
        <section class="cat-photos" aria-label={`Кто живёт в разделе «${category.title}»`}>
          {photos.map((p) => (
            <figure>
              <img src={p.src} alt={p.caption} loading="lazy" />
              <figcaption>
                <b>{p.caption}</b>
              </figcaption>
            </figure>
          ))}
        </section>
        {photoCredits.length > 0 && (
          <p class="strip-credits">
            Фото:{' '}
            {photoCredits.map((p, i) => (
              <>
                {i > 0 ? ', ' : ''}
                <a href={p.sourceUrl} target="_blank" rel="noopener nofollow">{p.author}</a>{p.license ? ` (${p.license})` : ''}
              </>
            ))}
          </p>
        )}
      </div>
    )
  }

  <div class="container container-wide" style="margin-top: 40px;">
    {
      subs.length > 0 && articles.length > 0 && (
        <div class="subtabs" role="tablist" aria-label={`Подразделы: ${category.title}`}>
          <button class="subtab" type="button" role="tab" aria-selected="true" data-sub="all">
            Все <span class="subtab-count">{articles.length}</span>
          </button>
          {subs.map((s) => (
            <button class="subtab" type="button" role="tab" aria-selected="false" data-sub={s.slug}>
              {s.title} <span class="subtab-count">{s.count > 0 ? s.count : '—'}</span>
            </button>
          ))}
        </div>
      )
    }

    {
      articles.length === 0 ? (
        <p style="color: var(--text-soft);">В этом разделе пока нет статей — скоро появятся.</p>
      ) : (
        <>
          <div class="grid" id="cat-grid">
            {articles.map((entry) => (
              <div class="grid-item" data-sub={entry.data.subcategory ?? ''}>
                <ArticleCard entry={entry} />
              </div>
            ))}
          </div>
          <p class="subtab-empty" hidden>В этом подразделе пока нет статей — скоро появятся.</p>
        </>
      )
    }
  </div>

  {/* Фильтр вкладок. Без JS вкладки скрыты (класс ставит сам скрипт), а все
      статьи просто видны списком — страница остаётся рабочей. */}
  <script is:inline>
    (() => {
      const tabs = document.querySelector('.subtabs');
      const grid = document.getElementById('cat-grid');
      if (!tabs || !grid) return;
      tabs.classList.add('is-ready');

      const items = Array.from(grid.querySelectorAll('.grid-item'));
      const empty = document.querySelector('.subtab-empty');

      tabs.addEventListener('click', (e) => {
        const btn = e.target.closest('.subtab');
        if (!btn) return;
        const sub = btn.dataset.sub;

        tabs.querySelectorAll('.subtab').forEach((b) => {
          b.setAttribute('aria-selected', String(b === btn));
        });

        let shown = 0;
        items.forEach((item) => {
          const match = sub === 'all' || item.dataset.sub === sub;
          item.hidden = !match;
          if (match) shown++;
        });
        if (empty) empty.hidden = shown > 0;
      });
    })();
  </script>
</BaseLayout>
