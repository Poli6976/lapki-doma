---
import '../../styles/tools.css';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { SITE } from '../../site.config.mjs';
import { PROFILES, KINDS, FAQ, PRICES } from '../../data/tool-costs.mjs';

const title = 'Калькулятор расходов на питомца: месяц, год и первый год';
const description =
  'Посчитайте, во сколько обойдётся кошка, собака, хомяк, крыса, морская свинка, кролик или попугай: разовые траты, каждый месяц, раз в год и запас на непредвиденное. Есть ориентиры цен из магазина с датой сбора.';

const dataJson = JSON.stringify({ profiles: PROFILES, kinds: KINDS, prices: PRICES });

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: FAQ.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })),
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Главная', item: new URL('/', SITE.url).href },
      { '@type': 'ListItem', position: 2, name: 'Инструменты', item: new URL('/instrumenty/', SITE.url).href },
      { '@type': 'ListItem', position: 3, name: 'Расчёт расходов на питомца', item: new URL('/instrumenty/raschet-rashodov-na-pitomca/', SITE.url).href },
    ],
  },
];
---

<BaseLayout title={title} description={description} jsonLd={jsonLd}>
  <div class="container container-wide tool-page" data-cost-tool>
    <nav class="tool-crumbs" aria-label="Навигация">
      <a href="/">Главная</a> / <a href="/instrumenty/">Инструменты</a> / Расчёт расходов
    </nav>
    <h1>Калькулятор расходов на питомца</h1>
    <p class="tool-lead">
      Выберите питомца, впишите цены из своих магазинов и клиник: посчитаем расходы за месяц, за год и за
      первый год. Заполняйте только то, что вам нужно.
    </p>

    <div class="tool-panel">
      <div class="tool-grid">
        <div class="tool-field">
          <label for="cost-species">Питомец</label>
          <select id="cost-species" class="tool-select">
            {PROFILES.map((p) => <option value={p.id}>{p.title}</option>)}
          </select>
        </div>
        <div class="tool-field">
          <label for="cost-reserve">Запас на непредвиденное, %</label>
          <input id="cost-reserve" class="tool-input" type="number" inputmode="decimal" min="0" max="200" step="1" value="10" />
        </div>
        <div class="tool-field">
          <label for="cost-years">Срок, лет (по желанию)</label>
          <input id="cost-years" class="tool-input" type="number" inputmode="decimal" min="0" step="0.5" placeholder="например 10" />
          <span class="tool-note" data-years-hint></span>
        </div>
      </div>

      <div class="cost-totals" aria-live="polite">
        <div class="cost-total"><span class="tool-label">Каждый месяц (регулярно)</span><strong data-out="month">0 ₽</strong></div>
        <div class="cost-total"><span class="tool-label">В среднем в месяц, с годовыми</span><strong data-out="avg">0 ₽</strong></div>
        <div class="cost-total"><span class="tool-label">Расходы за год</span><strong data-out="year">0 ₽</strong></div>
        <div class="cost-total"><span class="tool-label">Запас на непредвиденное в год</span><strong data-out="reserve">0 ₽</strong></div>
        <div class="cost-total"><span class="tool-label">Первый год с разовыми</span><strong data-out="first">0 ₽</strong></div>
        <div class="cost-total" data-total-years hidden><span class="tool-label" data-years-label>За весь срок</span><strong data-out="all">0 ₽</strong></div>
      </div>
      <p class="tool-note">Расходы за год = регулярные в месяц × 12 + суммы «раз в год»; запас считается от этой суммы и показан отдельно, итоги «первый год» и «за весь срок» уже включают его.</p>

      <p class="tool-note" data-bench-note hidden>
        Ориентиры цен: каталог {PRICES.shop}, {PRICES.city}, данные на {PRICES.date}. Показан разброс цен первых 20 позиций
        выдачи (от 10-го до 90-го процентиля) и середина, а не средняя цена по рынку. В вашем городе и магазине цены другие.
      </p>

      <div data-form></div>
      <div style="display: flex; gap: var(--sp-3); flex-wrap: wrap; margin-top: var(--sp-3);">
        <button type="button" class="tool-btn is-ghost" data-clear>Очистить</button>
        <button type="button" class="tool-btn is-ghost" data-print>Распечатать</button>
      </div>
    </div>

    <h2>Как пользоваться</h2>
    <ol>
      <li>Выберите питомца, список статей расходов подстроится под него.</li>
      <li>Узнайте цены в своём городе и впишите их. Для строк «раз в год» вносите сумму за весь год.</li>
      <li>Оставьте поле пустым, если статья вам не нужна. Лишние поля никого не смущают.</li>
      <li>Посмотрите на первый год и на запас: первый год почти всегда дороже.</li>
    </ol>
    <p>
      Если хотите понять, из чего складывается бюджет, прочитайте статьи
      <a href="/sovety/skolko-stoit-soderzhanie-koshki-ili-sobaki-v-mesyac/">сколько стоит содержание кошки или собаки в месяц</a>
      и <a href="/sovety/skolko-stoit-zavesti-pitomca-vpervye-razovye-traty-na-starte/">сколько стоит завести питомца впервые</a>.
      О страховке: <a href="/sovety/nuzhna-li-strahovka-dlya-pitomca/">нужна ли страховка питомцу</a>.
    </p>

    <h2>Частые вопросы</h2>
    <div class="tool-faq">
      {FAQ.map((f) => (
        <details>
          <summary>{f.q}</summary>
          <p>{f.a}</p>
        </details>
      ))}
    </div>
    <p class="tool-note">Калькулятор помогает планировать бюджет и не заменяет консультацию специалиста. Сроки жизни из подсказок взяты из наших статей и зависят от условий содержания.</p>
  </div>
</BaseLayout>

<script is:inline type="application/json" id="cost-data" set:html={dataJson}></script>

<script>
  const root = document.querySelector('[data-cost-tool]');
  const dataEl = document.getElementById('cost-data');
  if (root && dataEl) {
    const { profiles, kinds, prices } = JSON.parse(dataEl.textContent || '{}');
    const shopLabel = prices.shop + ', ' + prices.date;
    const benchNote = root.querySelector('[data-bench-note]');
    const speciesSel = root.querySelector('#cost-species');
    const reserveIn = root.querySelector('#cost-reserve');
    const yearsIn = root.querySelector('#cost-years');
    const yearsHint = root.querySelector('[data-years-hint]');
    const form = root.querySelector('[data-form]');
    const KEY = 'lapki-cost-v1';
    const outs = {};
    root.querySelectorAll('[data-out]').forEach((el) => (outs[el.getAttribute('data-out')] = el));
    const totalYears = root.querySelector('[data-total-years]');
    const yearsLabel = root.querySelector('[data-years-label]');

    const nf = new Intl.NumberFormat('ru-RU', { maximumFractionDigits: 0 });
    const money = (n) => nf.format(Math.round(n)) + ' ₽';
    const num = (v) => { const x = parseFloat(String(v).replace(',', '.')); return x > 0 && isFinite(x) ? x : 0; };

    let store = {};
    try { store = JSON.parse(localStorage.getItem(KEY) || '{}') || {}; } catch (e) { store = {}; }
    const save = () => { try { localStorage.setItem(KEY, JSON.stringify(store)); } catch (e) { /* без хранилища всё работает */ } };

    const profile = () => profiles.find((p) => p.id === speciesSel.value) || profiles[0];
    const bucket = () => (store[speciesSel.value] = store[speciesSel.value] || {});

    function buildForm() {
      const p = profile();
      const b = bucket();
      form.textContent = '';
      for (const kind of ['once', 'monthly', 'yearly']) {
        const lines = p.lines.filter((l) => l.kind === kind);
        if (!lines.length) continue;
        const sec = document.createElement('div');
        sec.className = 'cost-section';
        const h = document.createElement('h3');
        h.textContent = kinds[kind].title;
        const n = document.createElement('p');
        n.className = 'tool-note';
        n.textContent = kinds[kind].note;
        sec.append(h, n);
        for (const l of lines) {
          const row = document.createElement('div');
          row.className = 'cost-row';
          const lab = document.createElement('label');
          const id = 'cost-' + p.id + '-' + l.id;
          lab.setAttribute('for', id);
          lab.textContent = l.name;
          if (l.hint) {
            const s = document.createElement('span');
            s.className = 'tool-note';
            s.textContent = l.hint;
            lab.appendChild(s);
          }
          if (l.bench) {
            const s = document.createElement('span');
            s.className = 'tool-note';
            s.textContent = 'Ориентир: ' + l.bench + ' (' + shopLabel + ')';
            lab.appendChild(s);
          }
          const inp = document.createElement('input');
          inp.className = 'tool-input';
          inp.type = 'number';
          inp.inputMode = 'decimal';
          inp.min = '0';
          inp.step = '1';
          inp.placeholder = '0 ₽';
          inp.id = id;
          inp.dataset.line = l.id;
          inp.dataset.kind = l.kind;
          if (b[l.id]) inp.value = b[l.id];
          inp.addEventListener('input', () => {
            if (inp.value) bucket()[l.id] = inp.value; else delete bucket()[l.id];
            save();
            calc();
          });
          row.append(lab, inp);
          sec.appendChild(row);
        }
        form.appendChild(sec);
      }
      yearsHint.textContent = p.lifespanHint || '';
      benchNote.hidden = !p.lines.some((l) => l.bench);
    }

    function calc() {
      let once = 0, monthly = 0, yearly = 0;
      form.querySelectorAll('input[data-kind]').forEach((inp) => {
        const v = num(inp.value);
        if (inp.dataset.kind === 'once') once += v;
        else if (inp.dataset.kind === 'monthly') monthly += v;
        else yearly += v;
      });
      const reservePct = Math.min(200, num(reserveIn.value));
      const yearBase = monthly * 12 + yearly;
      const reserve = yearBase * reservePct / 100;
      const year = yearBase;
      outs.month.textContent = money(monthly);
      outs.avg.textContent = money(yearBase / 12);
      outs.year.textContent = money(year);
      outs.reserve.textContent = money(reserve);
      outs.first.textContent = money(once + yearBase + reserve);
      const years = num(yearsIn.value);
      if (years > 0) {
        totalYears.hidden = false;
        yearsLabel.textContent = 'За ' + nf.format(years) + ' лет с разовыми и запасом';
        outs.all.textContent = money(once + (yearBase + reserve) * years);
      } else {
        totalYears.hidden = true;
      }
    }

    function onChangeSpecies() { buildForm(); calc(); try { localStorage.setItem(KEY + '-last', speciesSel.value); } catch (e) { /* ok */ } }

    speciesSel.addEventListener('change', onChangeSpecies);
    reserveIn.addEventListener('input', calc);
    yearsIn.addEventListener('input', calc);
    root.querySelector('[data-clear]').addEventListener('click', () => {
      store[speciesSel.value] = {};
      save();
      buildForm();
      calc();
    });
    root.querySelector('[data-print]').addEventListener('click', () => window.print());

    try {
      const last = localStorage.getItem(KEY + '-last');
      if (last && profiles.some((p) => p.id === last)) speciesSel.value = last;
    } catch (e) { /* ok */ }
    buildForm();
    calc();
  }
</script>
