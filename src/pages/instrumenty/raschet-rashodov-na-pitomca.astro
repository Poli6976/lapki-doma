---
import '../../styles/tools.css';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { SITE } from '../../site.config.mjs';
import { BENCH, PRICES, QUICK_ROWS, EXAMPLE, FAQ } from '../../data/tool-costs.mjs';

const title = 'Калькулятор расходов на питомца: сколько в месяц и в год';
const description =
  'Впишите цену упаковки корма и на сколько дней её хватает: посчитаем траты на любого питомца в месяц и в год. Работает для кошек, собак, грызунов и птиц.';

const dataJson = JSON.stringify({ quick: QUICK_ROWS, example: EXAMPLE });

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: FAQ.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })),
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Главная', item: new URL('/', SITE.url).href },
      { '@type': 'ListItem', position: 2, name: 'Инструменты', item: new URL('/instrumenty/', SITE.url).href },
      { '@type': 'ListItem', position: 3, name: 'Расчёт расходов на питомца', item: new URL('/instrumenty/raschet-rashodov-na-pitomca/', SITE.url).href },
    ],
  },
];
---

<BaseLayout title={title} description={description} jsonLd={jsonLd}>
  <div class="container container-wide tool-page" data-cost-tool>
    <nav class="tool-crumbs" aria-label="Навигация">
      <a href="/">Главная</a> / <a href="/instrumenty/">Инструменты</a> / Расчёт расходов
    </nav>
    <h1>Калькулятор расходов на питомца</h1>
    <p class="tool-lead">
      Для любого питомца. Впишите цену упаковки корма и на сколько дней её хватает: посчитаем траты в месяц и в год.
    </p>

    <div class="tool-panel">
      <p class="tool-note" data-example-note>Сейчас подставлен пример. Замените числа своими, итог пересчитается сразу.</p>

      <div class="cost-bar" aria-live="polite">
        <div class="cost-total"><span class="tool-label">Каждый месяц</span><strong data-out="month">0 ₽</strong><span class="tool-note">Все регулярные покупки.</span></div>
        <div class="cost-total"><span class="tool-label">За год</span><strong data-out="year">0 ₽</strong><span class="tool-note">Регулярные покупки плюс ветеринар.</span></div>
        <div class="cost-total"><span class="tool-label">Первый год</span><strong data-out="first">0 ₽</strong><span class="tool-note">Год плюс покупки один раз.</span></div>
      </div>

      <h2 class="cost-h">1. Регулярные покупки</h2>
      <p class="tool-note">Цена упаковки и на сколько дней её хватает. Например, упаковка раз в 3 дня — впишите 3.</p>
      <div data-rows></div>
      <div class="cost-quick" data-quick aria-label="Добавить покупку"></div>

      <h2 class="cost-h">2. Покупки один раз</h2>
      <p class="tool-note">Клетка или лоток, переноска, миски, лежанка, игрушки: общая сумма.</p>
      <div class="cost-row">
        <label for="cost-once">Сумма, ₽</label>
        <input id="cost-once" class="tool-input" type="number" inputmode="decimal" min="0" step="1" placeholder="0" />
      </div>

      <h2 class="cost-h">3. Ветеринар и лекарства</h2>
      <p class="tool-note">Прививки и лекарства бывают по факту или по плану врача. Впишите, что знаете за год, или оставьте пустым.</p>
      <div class="cost-row">
        <label for="cost-vet">Сумма за год, ₽</label>
        <input id="cost-vet" class="tool-input" type="number" inputmode="decimal" min="0" step="1" placeholder="0" />
      </div>

      <div style="margin-top: var(--sp-4);">
        <button type="button" class="tool-btn is-ghost" data-clear>Очистить</button>
      </div>
    </div>

    <details class="tool-details">
      <summary>Сколько стоят упаковки в магазине (кошки и собаки)</summary>
      <p class="tool-note">
        Каталог {PRICES.shop}, {PRICES.city}, данные на {PRICES.date}. Показан разброс цен первых 20 позиций выдачи
        (от 10-го до 90-го процентиля) и середина, а не средняя цена по рынку. В вашем городе цены другие.
      </p>
      <div class="tool-table-wrap">
        <table class="tool-table">
          <thead><tr><th>Питомец</th><th>Что</th><th>Цена</th></tr></thead>
          <tbody>
            {BENCH.map((b) => (
              <tr><td>{b.pet}</td><td>{b.item}</td><td>{b.text}</td></tr>
            ))}
          </tbody>
        </table>
      </div>
    </details>

    <h2>Частые вопросы</h2>
    <div class="tool-faq">
      {FAQ.map((f) => (
        <details>
          <summary>{f.q}</summary>
          <p>{f.a}</p>
        </details>
      ))}
    </div>
    <p>
      Подробнее о том, из чего складываются расходы:
      <a href="/sovety/skolko-stoit-soderzhanie-koshki-ili-sobaki-v-mesyac/">сколько стоит содержание кошки или собаки в месяц</a>,
      <a href="/sovety/skolko-stoit-zavesti-pitomca-vpervye-razovye-traty-na-starte/">сколько стоит завести питомца впервые</a>,
      <a href="/sovety/nuzhna-li-strahovka-dlya-pitomca/">нужна ли страховка питомцу</a>.
    </p>
    <p class="tool-note">Калькулятор помогает планировать бюджет и не заменяет консультацию ветеринарного врача.</p>
  </div>
</BaseLayout>

<script is:inline type="application/json" id="cost-data" set:html={dataJson}></script>

<script>
  const root = document.querySelector('[data-cost-tool]');
  const dataEl = document.getElementById('cost-data');
  if (root && dataEl) {
    const { quick, example } = JSON.parse(dataEl.textContent || '{}');
    const KEY = 'lapki-cost-v2';
    const rowsBox = root.querySelector('[data-rows]');
    const quickBox = root.querySelector('[data-quick]');
    const onceIn = root.querySelector('#cost-once');
    const vetIn = root.querySelector('#cost-vet');
    const exNote = root.querySelector('[data-example-note]');
    const out = {};
    root.querySelectorAll('[data-out]').forEach((el) => (out[el.getAttribute('data-out')] = el));

    const nf = new Intl.NumberFormat('ru-RU', { maximumFractionDigits: 0 });
    const money = (n) => nf.format(Math.round(n)) + ' ₽';
    const num = (v) => { const x = parseFloat(String(v).replace(',', '.')); return x > 0 && isFinite(x) ? x : 0; };

    let isExample = true;

    function addRow(r) {
      const row = document.createElement('div');
      row.className = 'cost-line';
      const name = document.createElement('input');
      name.className = 'tool-input';
      name.type = 'text';
      name.maxLength = 40;
      name.placeholder = 'Что покупаете';
      name.setAttribute('aria-label', 'Название покупки');
      name.value = r.n || '';
      const price = document.createElement('input');
      price.className = 'tool-input';
      price.type = 'number';
      price.inputMode = 'decimal';
      price.min = '0';
      price.step = '1';
      price.placeholder = 'Цена упаковки, ₽';
      price.setAttribute('aria-label', 'Цена одной упаковки, рублей');
      if (r.p) price.value = r.p;
      const days = document.createElement('input');
      days.className = 'tool-input';
      days.type = 'number';
      days.inputMode = 'decimal';
      days.min = '0';
      days.step = '1';
      days.placeholder = 'Хватает, дней';
      days.setAttribute('aria-label', 'На сколько дней хватает упаковки');
      if (r.d) days.value = r.d;
      const sum = document.createElement('span');
      sum.className = 'cost-line-sum';
      const del = document.createElement('button');
      del.type = 'button';
      del.className = 'cost-del';
      del.setAttribute('aria-label', 'Убрать строку');
      del.textContent = '×';
      del.addEventListener('click', () => { row.remove(); touched(); });
      [name, price, days].forEach((el) => el.addEventListener('input', touched));
      row.append(name, price, days, sum, del);
      rowsBox.appendChild(row);
    }

    function readRows() {
      return [...rowsBox.querySelectorAll('.cost-line')].map((row) => {
        const [n, p, d] = row.querySelectorAll('input');
        return { n: n.value, p: p.value, d: d.value, el: row };
      });
    }

    function calc() {
      let yearRegular = 0;
      for (const r of readRows()) {
        const p = num(r.p), d = num(r.d);
        const sum = r.el.querySelector('.cost-line-sum');
        if (p > 0 && d > 0) {
          const y = (p * 365) / d;
          yearRegular += y;
          sum.textContent = '≈ ' + money(y / 12) + ' в месяц';
        } else {
          sum.textContent = '';
        }
      }
      const once = num(onceIn.value);
      const vet = num(vetIn.value);
      out.month.textContent = money(yearRegular / 12);
      out.year.textContent = money(yearRegular + vet);
      out.first.textContent = money(yearRegular + vet + once);
    }

    function save() {
      try {
        localStorage.setItem(KEY, JSON.stringify({
          rows: readRows().map(({ n, p, d }) => ({ n, p, d })),
          once: onceIn.value, vet: vetIn.value,
        }));
      } catch (e) { /* без хранилища всё работает */ }
    }

    function touched() {
      if (isExample) { isExample = false; exNote.hidden = true; }
      calc();
      save();
    }

    function load(state) {
      rowsBox.textContent = '';
      (state.rows && state.rows.length ? state.rows : [{}]).forEach(addRow);
      onceIn.value = state.once || '';
      vetIn.value = state.vet || '';
      calc();
    }

    quick.forEach((name) => {
      const b = document.createElement('button');
      b.type = 'button';
      b.className = 'tool-tab';
      b.textContent = '+ ' + name;
      b.addEventListener('click', () => { addRow({ n: name }); touched(); });
      quickBox.appendChild(b);
    });
    const other = document.createElement('button');
    other.type = 'button';
    other.className = 'tool-tab';
    other.textContent = '+ Другое';
    other.addEventListener('click', () => { addRow({}); touched(); });
    quickBox.appendChild(other);

    [onceIn, vetIn].forEach((el) => el.addEventListener('input', touched));
    root.querySelector('[data-clear]').addEventListener('click', () => {
      isExample = false;
      exNote.hidden = true;
      load({});
      save();
    });

    let stored = null;
    try { stored = JSON.parse(localStorage.getItem(KEY) || 'null'); } catch (e) { stored = null; }
    if (stored && typeof stored === 'object') {
      isExample = false;
      exNote.hidden = true;
      load(stored);
    } else {
      load({ rows: example.rows, once: example.once, vet: example.vet || '' });
    }
  }
</script>
