---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { CAT_BREEDS } from '../../data/breeds-koshki.mjs';
import { DOG_BREEDS } from '../../data/breeds-sobaki.mjs';
import { PARROT_SPECIES } from '../../data/breeds-popugai.mjs';
import breedPhotos from '../../data/breed-photos.json';
import { articleUrl, categoryUrl } from '../../lib/urls.mjs';
import { HUB_INTROS } from '../../data/category-intros.mjs';

/**
 * Справочник пород: /porody/koshki и /porody/sobaki.
 *
 * Зачем страница нужна: человек приходит «посмотреть породы» задолго до того,
 * как у нас написан портрет каждой из них. Раньше он попадал в категорию и
 * видел статьи про лоток и линьку — не то, за чем шёл. Здесь он видит сами
 * породы: фото, короткое описание и ссылку на портрет там, где тот уже есть.
 *
 * Породы, про которые статьи ещё нет, честно помечены «портрет готовим» —
 * это лучше, чем ссылка в никуда или заглушка «страница в разработке».
 */
export function getStaticPaths() {
  return [
    {
      params: { species: 'koshki' },
      props: {
        title: 'Породы кошек',
        lead: 'Как порода узнаётся и о чём стоит знать заранее. Порода задаёт склонность, а не гарантию характера: конкретный котёнок может оказаться совсем не таким, как описание.',
        category: 'koshki',
        categoryTitle: 'Кошки',
        breeds: CAT_BREEDS,
      },
    },
    {
      params: { species: 'sobaki' },
      props: {
        title: 'Породы собак',
        lead: 'Как порода узнаётся и о чём стоит знать заранее. Порода задаёт склонность, а не гарантию характера: многое зависит от конкретной собаки и от того, сколько с ней занимаются.',
        category: 'sobaki',
        categoryTitle: 'Собаки',
        breeds: DOG_BREEDS,
      },
    },
    {
      params: { species: 'popugai' },
      props: {
        title: 'Виды попугаев',
        lead: 'Комнатных попугаев гораздо больше, чем волнистый и корелла. У каждого вида свой размер, голос и характер — и это стоит узнать до, а не после покупки.',
        category: 'popugai',
        categoryTitle: 'Попугаи',
        breeds: PARROT_SPECIES,
      },
    },
  ];
}

const { species } = Astro.params;
const { title, lead, category, categoryTitle, breeds } = Astro.props;

const published = await getCollection('articles', ({ data }) =>
  import.meta.env.PROD ? !data.draft : true,
);
const articleById = new Map(published.map((e) => [e.id, e]));

// Фото ищем по ключу породы: имя файла собрано скриптом как `<вид>-<key>.jpg`.
const photoFor = (key) =>
  (breedPhotos[species] ?? []).find((p) => p.src.includes(`/${species}-${key}.`));

const items = breeds.map((b) => {
  const entry = b.article ? articleById.get(b.article) : undefined;
  return {
    ...b,
    href: entry ? articleUrl(entry) : undefined,
    photo: photoFor(b.key),
  };
});

const ready = items.filter((i) => i.href).length;

// Вводный текст и главные статьи хаба (src/data/category-intros.mjs).
const hub = HUB_INTROS[species];
const featured = (hub?.featured ?? [])
  .map((id) => articleById.get(id))
  .filter(Boolean);

// Подборки («Какие породы подходят для семьи», «Собака для квартиры») лежат в той же
// вкладке «Породы» рубрики, но портретом породы не являются. Показываем их отдельно,
// чтобы число на вкладке рубрики (портреты + подборки) сходилось с числом пород здесь.
const portraitIds = new Set(breeds.map((b) => b.article).filter(Boolean));
const roundups = published.filter(
  (e) =>
    e.data.category === category &&
    ['porody', 'vidy'].includes(e.data.subcategory) &&
    !portraitIds.has(e.id),
);

// CC BY / CC BY-SA требуют указать автора, public domain и CC0 — нет.
const credits = items
  .map((i) => i.photo)
  .filter((p) => p && p.author && !/public domain|^cc0/i.test(String(p.license ?? '')));

const description = `${title}: как порода узнаётся, какой характер и что учесть перед тем, как взять питомца. ${breeds.length} пород, ${ready} с подробным разбором.`;
---

<BaseLayout title={hub?.seoTitle ?? title} description={description}>
  <section class="hero">
    <div class="container">
      <h1>{title}</h1>
      <p class="lead">{lead}</p>
      {hub?.extraIntro?.map((para) => <p class="lead">{para}</p>)}
      <nav class="situations" aria-label="Разделы">
        <a class="situation" href={categoryUrl(category)}>Все статьи про раздел «{categoryTitle}»</a>
      </nav>
    </div>
  </section>

  <div class="container container-wide">
    <ul class="breed-grid">
      {
        items.map((b) => (
          <li class="breed-card" id={b.key}>
            {b.photo ? (
              <img class="breed-photo" src={b.photo.src} alt={b.name} loading="lazy" width="400" height="300" />
            ) : (
              <div class="breed-photo breed-photo-empty" aria-hidden="true"></div>
            )}
            <div class="breed-body">
              <h2>{b.name}</h2>
              <p>{b.blurb}</p>
              {b.href ? (
                <a class="breed-link" href={b.href}>
                  Подробно о породе →
                </a>
              ) : (
                <span class="breed-soon">Портрет породы готовим</span>
              )}
            </div>
          </li>
        ))
      }
    </ul>

    {
      (featured.length > 0 || roundups.length > 0) && (
        <section class="cat-intro article-body" aria-label="С чего начать выбор">
          <h2>С чего начать выбор</h2>
          <ul class="cat-featured">
            {[...roundups, ...featured.filter((f) => !roundups.includes(f))].map((e) => (
              <li><a href={articleUrl(e)}>{e.data.title}</a></li>
            ))}
          </ul>
        </section>
      )
    }

    {
      credits.length > 0 && (
        <p class="strip-credits">
          Фото:{' '}
          {credits.map((p, i) => (
            <>
              {i > 0 ? ', ' : ''}
              <a href={p.sourceUrl} target="_blank" rel="noopener nofollow">
                {p.author}
              </a>
              {p.license ? ` (${p.license})` : ''}
            </>
          ))}
        </p>
      )
    }
  </div>
</BaseLayout>
